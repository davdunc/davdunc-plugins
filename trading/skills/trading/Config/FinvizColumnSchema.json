        { "id": 46, "name": "Performance (Year)",           "category": "performance",    "assetScope": "mixed"  },
        { "id": 47, "name": "Performance (YTD)",            "category": "performance",    "assetScope": "mixed"  },
        { "id": 48, "name": "Beta",                         "category": "technical",      "assetScope": "equity" },
        { "id": 49, "name": "Average True Range",           "category": "technical",      "assetScope": "mixed"  },
        { "id": 50, "name": "Volatility (Week)",            "category": "technical",      "assetScope": "mixed"  },
        { "id": 51, "name": "Volatility (Month)",           "category": "technical",      "assetScope": "mixed"  },
        { "id": 52, "name": "20-Day Simple Moving Average", "category": "technical",      "assetScope": "mixed"  },
        { "id": 53, "name": "50-Day Simple Moving Average", "category": "technical",      "assetScope": "mixed"  },
        { "id": 54, "name": "200-Day Simple Moving Average","category": "technical",      "assetScope": "mixed"  },
