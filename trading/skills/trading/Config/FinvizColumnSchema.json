        { "id": 76, "name": "Employees",                    "category": "fundamentals",   "assetScope": "equity" },
        { "id": 77, "name": "EPS Next Q",                   "category": "fundamentals",   "assetScope": "equity" },
        { "id": 78, "name": "Income",                       "category": "fundamentals",   "assetScope": "equity" },
        { "id": 79, "name": "Index",                        "category": "classification", "assetScope": "mixed"  },
        { "id": 80, "name": "Optionable",                   "category": "classification", "assetScope": "equity" },
        { "id": 81, "name": "Prev Close",                   "category": "price-volume",   "assetScope": "mixed"  },
        { "id": 82, "name": "Sales",                        "category": "fundamentals",   "assetScope": "equity" },
        { "id": 83, "name": "Shortable",                    "category": "classification", "assetScope": "equity" },
